From 0621f6549537965326cf02120bcddc4ca77cb8fe Mon Sep 17 00:00:00 2001
From: relativesharp <relativesharp@gmail.com>
Date: Fri, 11 Sep 2026 07:42:52 +0200
Subject: [PATCH] kraken3: abort the upload when the device refuses the bucket
 setup

KrakenZ3._send_data only logs a refused bucket setup and then streams
the whole image into the bulk endpoint anyway. The transfer cannot land
anywhere, the bucket switch fails afterwards and the caller never learns
that the image did not reach the screen.

On the Kraken 2024 Elite RGB, which refuses the setup sporadically even
with free image memory, streaming regardless under a periodic upload
workload is the situation in which our device wedged into its bootloader
(USB 1e71:3011) twice, recoverable only by cutting standby power.

Raise ExpectationNotMet before any bulk data is sent instead. The bucket
switch failure keeps its log line: at that point nothing more is
streamed. The sporadic refusals themselves are not addressed here.

Refs #774
---
 liquidctl/driver/kraken3.py |  9 ++++++---
 tests/test_kraken3.py       | 14 ++++++++++++++
 2 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/liquidctl/driver/kraken3.py b/liquidctl/driver/kraken3.py
index 8ef2767..fe18053 100644
--- a/liquidctl/driver/kraken3.py
+++ b/liquidctl/driver/kraken3.py
@@ -26,7 +26,7 @@ if sys.platform == "win32":
     from winusbcdc import WinUsbPy
 
 from liquidctl.driver.usb import PyUsbDevice, UsbHidDriver
-from liquidctl.error import NotSupportedByDevice, NotSupportedByDriver
+from liquidctl.error import ExpectationNotMet, NotSupportedByDevice, NotSupportedByDriver
 from liquidctl.util import (
     LazyHexRepr,
     normalize_profile,
@@ -1021,9 +1021,12 @@ class KrakenZ3(KrakenX3):
             bucketIndex = 0  # start from byte 0
             bucketMemoryStart = [0x0, 0x0]
 
-        # setup bucket for transfer
+        # setup bucket for transfer; the device refuses this sporadically
+        # (observed on the 2024 Elite even with free memory), and streaming
+        # the image regardless has wedged devices into their bootloader
+        # (see issue #774), so abort before any bulk data is sent
         if not self._setup_bucket(bucketIndex, bucketIndex + 1, bucketMemoryStart, dataSizeBytes):
-            _LOGGER.error("Failed to setup bucket for data transfer")
+            raise ExpectationNotMet("device refused the bucket setup, image not sent")
 
         self._write_then_read([0x36, 0x01, bucketIndex])  # start data transfer
         self._bulk_write(header)
diff --git a/tests/test_kraken3.py b/tests/test_kraken3.py
index 006b31a..1e89511 100644
--- a/tests/test_kraken3.py
+++ b/tests/test_kraken3.py
@@ -6,6 +6,7 @@ import os
 from _testutils import MockHidapiDevice, MockPyusbDevice, Report
 
 from liquidctl.driver.hwmon import HwmonDevice
+from liquidctl.error import ExpectationNotMet
 from liquidctl.driver.kraken3 import KrakenX3, KrakenZ3
 from liquidctl.driver.kraken3 import (
     _COLOR_CHANNELS_KRAKENX,
@@ -551,6 +552,19 @@ def test_krakenz3_screen_not_totally_broken(mock_krakenz3):
     )
 
 
+def test_krakenz3_refused_bucket_setup_aborts_before_streaming(mock_krakenz3):
+    """A refused bucket setup must raise instead of streaming the image."""
+    mock_krakenz3.initialize()
+    mock_krakenz3._setup_bucket = lambda *args: False
+    with pytest.raises(ExpectationNotMet):
+        mock_krakenz3.set_screen(
+            "lcd",
+            "static",
+            os.path.join(os.path.dirname(os.path.abspath(__file__)), "yellow.jpg"),
+        )
+    assert mock_krakenz3.bulk_data_index == 0
+
+
 @pytest.mark.skip("Currently broken with pillow >= 10.2.0 (see #661)")
 def test_krakenz3_screen_not_totally_broken_part2(mock_krakenz3):
     """Reasonable example calls to untested APIs do not raise exceptions."""
