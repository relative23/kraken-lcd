[Unit]
Description=kraken-lcd — live system stats on NZXT Kraken LCD coolers
Documentation=https://github.com/relative23/kraken-lcd
# Never run concurrently with other owners of the same USB device
Conflicts=coolercontrold.service
# Never hammer a wedged device with restart attempts
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# notify + watchdog: the main loop pings before every tile (~10-15 s);
# if the process ever hangs (e.g. a USB stall inside hidapi), systemd
# restarts it after 90 s
Type=notify
NotifyAccess=main
WatchdogSec=90
ExecStart=/usr/bin/python3 -m kraken_lcd run
WorkingDirectory=/opt/kraken-lcd
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=30
# exit code 78 = device stuck in its bootloader: restarts are pointless,
# recovery needs a power cycle (see README, troubleshooting)
RestartPreventExitStatus=78
# enough time to hand the LCD back to the firmware screen on stop
TimeoutStopSec=25

# least privilege: dedicated system user; device access is granted by the
# udev rule (60-kraken-lcd.rules, GROUP=kraken-lcd)
User=kraken-lcd
Group=kraken-lcd

# hardening (the service only needs USB access, /opt/kraken-lcd read-only,
# and its cache directory)
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
CacheDirectory=kraken-lcd

[Install]
WantedBy=multi-user.target
